{
  "name": "kenna-calorie-tracker",
  "version": "1.0.0",
  "description": "Private calorie and weight tracker: an installable offline phone app, plus an optional Node server version",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "serve:docs": "node scripts/serve-docs.js",
    "build": "node scripts/build.js",
    "build:watch": "node scripts/build.js --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
