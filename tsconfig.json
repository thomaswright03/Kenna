{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["docs/**/*.js", "docs/globals.d.ts", "scripts/**/*.js"],
  "exclude": ["docs/sw.js", "docs/build"]
}
